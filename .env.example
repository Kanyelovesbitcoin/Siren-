# Copy to .env.local — Siren reads these on the server only. Never commit real keys.

# Optional: server-side key for OpenRouter / OpenAI-compatible judge providers.
# If set, you can leave the API key field in the dashboard blank.
SIREN_JUDGE_API_KEY=

# Optional: comma-separated extra hostnames you explicitly trust as targets
# (e.g. a dev container name). Exact matches only, no wildcards.
# Leave empty to keep the strict localhost lock.
SIREN_ALLOWED_HOSTS=

# Request timeout (ms) for each call to your target app.
SIREN_TARGET_TIMEOUT_MS=30000

# Optional: where Siren looks for a setup saved by your coding agent
# ("Connect My App"). Defaults to siren.config.json in the Siren folder.
SIREN_CONFIG_FILE=

# Optional: pause between ordinary test requests, in milliseconds.
# Default is a random 300-500 ms so audits don't trip your app's rate limiter. 0 turns it off.
SIREN_PACING_MS=
